      "refersTo": "feedback-good",
      "description": "Authored geometry remains decorative beside its meaning.",
      "html": "<div class=\"ds-feedback\"><span class=\"ds-feedback-label\">Result</span><span class=\"ds-feedback-icon\" aria-hidden=\"true\"><svg class=\"ds-svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"m5 12 4 4 10-10\"/></svg></span><span>Correct school</span></div>",
      "css": ".ds-feedback{display:flex;flex-wrap:wrap;gap:4px;align-items:center;font:400 .875rem/1.5 \"Open Sans\",Arial,sans-serif;color:var(--csp-stone,#585551)}.ds-feedback-label{flex-basis:100%;font-weight:600;color:var(--text-strong,#303e35)}.ds-feedback-icon{display:inline-grid;place-items:center;width:1.5em;min-width:22px;height:1.5em;flex:0 0 1.5em;border-radius:4px;background:#e3f1db;color:#245f05}.ds-svg{width:85%;height:85%}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}"
    },
    {
      "name": "Status Surface",
      "kind": "card",
      "refersTo": "status",
      "description": "A quiet place for state and recovery information.",
      "html": "<div class=\"ds-status\" role=\"status\"><strong>Puzzle in progress</strong><p>Compare the size, grades, and direction feedback.</p></div>",
      "css": ".ds-status{padding:14px 16px;border-radius:12px;background:var(--surface-secondary,#eef2ed);color:var(--csp-stone,#585551);font:400 1rem/1.5 \"Open Sans\",Arial,sans-serif}.ds-status p{margin:4px 0 0;font-size:.875rem}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}"
    },
    {
      "name": "Ranking Entry",
      "kind": "custom",
      "refersTo": "panel",
      "description": "A readable identity and metric with native aggregate details.",
      "html": "<ol class=\"ds-rank-list\"><li class=\"ds-rank-entry\"><div class=\"ds-rank-row\"><span class=\"ds-rank\">1</span><div class=\"ds-identity\"><strong>Community player</strong><p>School or organization</p></div><div class=\"ds-metric\"><strong>6</strong><span>Points</span></div></div><details class=\"ds-details\"><summary>Score details</summary><dl class=\"ds-stats\"><div><dt>Points</dt><dd>6</dd></div><div><dt>Solved / played</dt><dd>1 / 1</dd></div></dl></details></li></ol>",
      "css": ".ds-rank-list{list-style:none;margin:0;padding:0;font:400 1rem/1.5 \"Open Sans\",Arial,sans-serif;color:var(--csp-stone,#585551)}.ds-rank-entry{padding:20px 0 10px;border-bottom:1px solid var(--line,#dce2d8)}.ds-rank-row{display:grid;grid-template-columns:28px minmax(0,1fr) 90px;gap:12px;align-items:start}.ds-rank{color:var(--csp-sage,#4c6970);font-variant-numeric:tabular-nums;padding-top:2px}.ds-identity{min-width:0;overflow-wrap:break-word}.ds-identity strong,.ds-metric strong{color:var(--text-strong,#303e35);font-weight:700}.ds-identity p{margin:4px 0 0;font-size:.875rem}.ds-metric{display:flex;flex-direction:column;text-align:right;font-variant-numeric:tabular-nums}.ds-metric strong{font-size:1.25rem}.ds-metric span{font-size:.875rem}.ds-details{margin:4px 0 0 40px}.ds-details summary{cursor:pointer;min-height:44px;padding:11px 0;color:var(--csp-slate,#365b5e);font-size:.875rem;font-weight:600}.ds-details summary::marker{color:var(--csp-sage,#4c6970)}.ds-details summary:focus-visible{outline:3px solid var(--csp-slate,#365b5e);outline-offset:3px}.ds-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:4px 0 12px;font-size:.875rem}.ds-stats dt{font-weight:400}.ds-stats dd{margin:3px 0 0;font-weight:600;color:var(--text-strong,#303e35);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}@media(max-width:600px){.ds-rank-row{grid-template-columns:20px minmax(0,1fr) 64px;gap:8px}.ds-details{margin-left:28px}.ds-metric strong{font-size:1.125rem}.ds-stats{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}"
    },
    {
      "name": "Account Dialog",
      "kind": "custom",
      "refersTo": "dialog",
      "description": "Native bounded dialog with a retained-details state.",
      "html": "<dialog class=\"ds-dialog\" open aria-labelledby=\"ds-dialog-title\"><h2 id=\"ds-dialog-title\">Check your email</h2><p>Open the confirmation link in this browser to continue.</p><p class=\"ds-sent\" role=\"status\">Your profile details are retained. Confirmation finishes joining automatically.</p><button class=\"ds-close\" type=\"button\">Close sign-in</button></dialog>",
      "css": ".ds-dialog{width:min(540px,calc(100% - 24px));max-height:calc(100dvh - 24px);margin:auto;padding:28px;border:0;border-radius:16px;color:var(--csp-stone,#585551);background:var(--csp-white,#fff);box-shadow:0 24px 60px rgba(25,45,30,.24);overflow:auto;overflow-wrap:anywhere;font:400 1rem/1.5 \"Open Sans\",Arial,sans-serif}.ds-dialog::backdrop{background:rgba(30,44,36,.58)}.ds-dialog h2{margin:0 0 12px;color:var(--text-strong,#303e35);font-size:1.375rem;line-height:1.3}.ds-dialog p{margin:0}.ds-dialog .ds-sent{margin:16px 0;background:var(--surface-secondary,#eef2ed);padding:16px;border-radius:12px}.ds-close{font-family:\"Open Sans\",Arial,sans-serif;font-size:1rem;line-height:1.4;font-weight:600;min-height:44px;min-width:44px;border:1px solid transparent;border-radius:8px;padding:10px 14px;cursor:pointer;transition:background-color 160ms ease-out,color 160ms ease-out;background:var(--csp-white,#fff);color:var(--csp-slate,#365b5e);border-color:var(--line,#dce2d8)}.ds-close:hover{background:var(--surface-secondary,#eef2ed);border-color:var(--csp-sage,#4c6970)}.ds-close:focus-visible{outline:3px solid var(--csp-slate,#365b5e);outline-offset:3px}@media(max-width:600px){.ds-dialog{padding:22px 18px}.ds-dialog h2{font-size:1.125rem}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}"
    }
  ],
  "narrative": {
    "northStar": "The CSP Daily Game",
    "overview": "The CSP Daily Game carries the supplied Charter Success Partners logo, Open Sans, and the established green, sage, stone, cream, and white palette into a compact, practical interface. Quiet surfaces and a clear size-and-weight hierarchy give real school content and the next action priority.\n\nThe system is flat at rest: one main white panel, tonal state surfaces, and thin dividers organize the work. Small authored SVGs explain controls and feedback alongside readable labels. The brand comes from its existing identity assets, color, and type; it does not require a new illustrative world.",
    "keyCharacteristics": [
      "Compact task-first composition with readable supporting text.",
      "Deep green primary actions; sage secondary actions and navigation.",
      "Restrained curved corners, tonal feedback, and divider-led lists.",
      "Native controls, visible focus, and deliberate mobile reflow."
    ],
    "rules": [
      {
        "name": "The Task Green Rule",
        "body": "Use deep CSP green for the primary action and current or successful game state; keep secondary actions in sage or slate.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Use Open Sans throughout the interface; establish hierarchy with size, weight, and spacing.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Keep page panels and list rows flat; reserve the ambient shadow for dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the supplied CSP logo and Open Sans with the established palette.",
      "Do pair feedback icons with visible text and keep state changes available to live announcements.",
      "Do let names, affiliations, clues, and field text wrap; preserve the selected ranking metric beside identity.",
      "Do retain keyboard focus, the school finder alternative, and reduced-motion behavior.",
      "Do expose public-listing and today-only guest carryover information before joining."
    ],
    "donts": [
      "Don't replace native controls or labeled SVGs with emoji or font-glyph icons.",
      "Don't add decorative gradients, repeated nested card shells, or pill navigation to this retained CSP system.",
      "Don't use color alone to explain result, comparison, or selection states.",
      "Don't compress rankings into a horizontally scrolling table or clip community names.",
      "Don't make account or ranking failures block guest play."
    ]
  }
}
